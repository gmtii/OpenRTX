diff --git a/encoder/mbeenc.cpp b/encoder/mbeenc.cpp
index 55ea2ea..d631a26 100755
--- a/encoder/mbeenc.cpp
+++ b/encoder/mbeenc.cpp
@@ -584,8 +584,19 @@ void MBEEncoder::encode_dmr(const unsigned char* in, unsigned char* out)
 	/* Golay encode A */
 	unsigned int a = CGolay24128::encode24128(aOrig);
 
-	/* PRNG scramble and Golay encode B */
-	unsigned int p = PRNG_TABLE[aOrig] >> 1;
+	/* PRNG scramble and Golay encode B. OpenRTX C62: the mask computed as
+	 * the decoders (mbelib, OpenDMR's own) remove it, seeded by the 12 bits
+	 * of A; PRNG_TABLE does not hold that sequence, and with it no decoder
+	 * got the B block (C1) right. */
+	unsigned int p = 0U;
+	{
+		unsigned int pr = 16U * aOrig;
+		for (unsigned int i = 1U; i <= 23U; i++) {
+			pr = (173U * pr + 13849U) % 65536U;
+			if (pr >= 32768U)
+				p |= 1U << (23U - i);
+		}
+	}
 	unsigned int b = CGolay24128::encode23127(bOrig) >> 1;
 	b ^= p;
 
@@ -607,3 +618,21 @@ void MBEEncoder::encode_dmr(const unsigned char* in, unsigned char* out)
 		WRITE_BIT(out, DMR_C_TABLE[i], cOrig & MASK);
 	}
 }
+
+void MBEEncoder::encode_dmr_frame(const int16_t samples[], unsigned char out[9],
+                                  unsigned char ambe49[49])
+{
+	int b[9];
+	uint8_t bits[49];
+	unsigned char in[7] = { 0 };
+
+	encode_dmr_params(samples, b);
+	encode_49bit(bits, b);
+	for (unsigned int i = 0U; i < 49U; i++) {
+		if (bits[i])
+			in[i >> 3] |= (unsigned char)(0x80U >> (i & 7U));
+		if (ambe49)
+			ambe49[i] = bits[i];
+	}
+	encode_dmr(in, out);
+}
